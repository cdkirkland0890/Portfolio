# Copy to .env and replace values. Never commit .env or provider credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/giving-tree.sqlite

# Local age-band options; keep this list consistent with the application form.
AGE_BANDS=0–2,3–4,5–6,7–8,9–12,13+

# Create password hashes with: node server/hash-password.mjs
# JSON format: [{"email":"staff@example.org","role":"admin","passwordHash":"salt:hash"}]
ADMIN_USERS_JSON=[]

# REQUIRED BEFORE PRODUCTION. Retention period is a program decision; do not guess.
# Set to an approved whole number of days (1–3650) after the program decides.
RETENTION_DAYS=

# Azure Communication Services Email (optional for local development; required for production).
ACS_ENDPOINT=
ACS_ACCESS_KEY=
ACS_SENDER_ADDRESS=
STAFF_NOTIFICATION_EMAIL=
ADMIN_URL=http://127.0.0.1:3000/admin

# Restricted Google service-account integration (optional locally; required for production).
# Use a one-line JSON service-account key. Grant the account Editor access only to the
# dedicated, private spreadsheet. Each row contains guardian name/email, battery,
# one child's age band/gender, optional clothing sizes, interests, four wish-list items,
# and sensory/allergy concerns, plus application ID/status/timestamps. Use columns A:S.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=GivingTree!A:S
